# все служебные папки: .venv (окружение Python), .vscode, .claude и т. п.
.*/
# кроме памятки для Claude Code (уберите эти две строки, если она в git не нужна)
!.claude/
.claude/*
!.claude/CLAUDE.md

# кэши Python
__pycache__/
.pytest_cache/

# папки экспериментов (настройки с личными путями, результаты) — в git не храним; в git только пример
# experiments/example и current.py, который его выбирает. Чтобы git не замечал свой выбор эксперимента
# в current.py, после скачивания проекта один раз: git update-index --skip-worktree experiments/current.py
experiments/*
!experiments/current.py
!experiments/example/
experiments/example/results/
